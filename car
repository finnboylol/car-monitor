#!/usr/bin/env python3
"""Terminal client for the GWES Central Alert Repository (CAR) API v2."""

import argparse
import sys
import time

import requests

API_URL = "https://alerts.globaleas.org/api/v2/alerts/all"
REFRESH_SECONDS = 60


def fetch_alerts(page):
    response = requests.get(
        API_URL,
        params={"page": page},
        headers={"Accept": "application/json"},
        timeout=15,
    )
    response.raise_for_status()
    data = response.json()

    if not isinstance(data, list):
        raise ValueError("CAR API returned an unexpected response (expected a JSON list).")
    return data


def alert_key(alert):
    return str(alert.get("hash") or alert.get("id") or alert.get("cacheKey") or repr(alert))


def display(alerts, page):
    print(f"\nCAR Monitor | Page {page}")
    print("=" * 65)

    if not alerts:
        print("No alerts returned.")
        return

    for alert in alerts:
        alert_type = str(alert.get("type") or "???")
        severity = str(alert.get("severity") or "UNKNOWN")
        callsign = str(alert.get("callsign") or "Unknown").strip()
        start = alert.get("startTime") or "Unknown"
        message = str(alert.get("translation") or "No message available").strip()

        print(f"\n#{alert.get('id', '?')} | {alert_type} | {severity}")
        print(f"Time: {start} | Station: {callsign}")
        print(message)

    print(f"\n{len(alerts)} alert(s) shown.")


def main():
    parser = argparse.ArgumentParser(
        description="Browse recent alerts from the GWES Central Alert Repository."
    )
    parser.add_argument(
        "--page", type=int, default=1,
        help="Page number to retrieve (10 alerts per page; default: 1)",
    )
    parser.add_argument(
        "--limit", type=int, default=10,
        help="Maximum number of alerts to display (default: 10)",
    )
    parser.add_argument(
        "--type", dest="alert_type",
        help="Only show this alert type, e.g. RWT, SVR, TOR or CEM",
    )
    parser.add_argument(
        "--watch", action="store_true",
        help=f"Watch the selected page for new alerts (refresh every {REFRESH_SECONDS} seconds)",
    )
    args = parser.parse_args()

    if len(sys.argv) == 1:
        parser.print_help()
        return 0

    if args.page < 1:
        parser.error("--page must be at least 1")
    if args.limit < 1:
        parser.error("--limit must be at least 1")

    seen = set()
    first_pass = True

    try:
        while True:
            alerts = fetch_alerts(args.page)

            if args.alert_type:
                wanted = args.alert_type.upper()
                alerts = [
                    alert for alert in alerts
                    if str(alert.get("type", "")).upper() == wanted
                ]

            if args.watch:
                if first_pass:
                    current = alerts[:args.limit]
                    display(current, args.page)
                    seen.update(alert_key(alert) for alert in alerts)
                    first_pass = False
                else:
                    fresh = [
                        alert for alert in alerts
                        if alert_key(alert) not in seen
                    ]
                    seen.update(alert_key(alert) for alert in alerts)
                    if fresh:
                        display(fresh, args.page)
                    else:
                        print("No new alerts.")
            else:
                display(alerts[:args.limit], args.page)
                return 0

            time.sleep(REFRESH_SECONDS)

    except KeyboardInterrupt:
        print("\nMonitoring stopped.")
        return 0
    except requests.RequestException as error:
        print(f"CAR connection error: {error}", file=sys.stderr)
        return 1
    except (ValueError, TypeError) as error:
        print(f"CAR response error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
